+
+def _get_cline_five_hour_percent() -> Optional[int]:
+    """Fetch percentUsed from Cline limits endpoint with 30s in-memory cache."""
+    import json
+    import time
+    import urllib.request
+    from pathlib import Path
+
+    now = time.time()
+    if now - _CLINE_LIMIT_CACHE["ts"] < 30.0 and _CLINE_LIMIT_CACHE["percent"] is not None:
+        return _CLINE_LIMIT_CACHE["percent"]
+
+    api_key = os.environ.get("CLINE_API_KEY") or os.environ.get("Cline_API_KEY")
+    if not api_key:
+        env_file = Path(os.path.expanduser("~/.hermes/.env"))
+        if env_file.exists():
+            try:
+                for line in env_file.read_text().splitlines():
+                    line = line.strip()
+                    if line.startswith("Cline_API_KEY=") or line.startswith("CLINE_API_KEY="):
+                        api_key = line.split("=", 1)[1].strip().strip('"').strip("'")
+                        break
+            except Exception:
+                pass
+
+    if not api_key:
+        return None
+
+    try:
+        req = urllib.request.Request(
+            "https://api.cline.bot/api/v1/users/me/plan/usage-limits",
+            headers={"Authorization": f"Bearer {api_key}", "User-Agent": "hermes-agent"}
+        )
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            data = json.loads(resp.read().decode())
+            limits = data.get("data", {}).get("limits", [])
+            for lim in limits:
+                if lim.get("type") == "five_hour":
+                    pct = lim.get("percentUsed")
+                    if pct is not None:
+                        val = int(round(pct))
+                        _CLINE_LIMIT_CACHE["ts"] = now
+                        _CLINE_LIMIT_CACHE["percent"] = val
+                        return val
+    except Exception:
+        pass
+    return None
+
+
+def _get_codex_five_hour_remaining_percent() -> Optional[int]:
+    """Return the Codex session-window percentage remaining, cached for 30s."""
+    import time
+
+    now = time.time()
+    if now - _CODEX_LIMIT_CACHE["ts"] < 30.0 and _CODEX_LIMIT_CACHE["percent"] is not None:
+        return _CODEX_LIMIT_CACHE["percent"]
+
+    try:
+        from agent.account_usage import fetch_account_usage
+
+        snapshot = fetch_account_usage("openai-codex")
+        for window in snapshot.windows if snapshot else ():
+            if window.label == "Session" and window.used_percent is not None:
+                remaining = max(0, min(100, round(100 - float(window.used_percent))))
+                _CODEX_LIMIT_CACHE["ts"] = now
+                _CODEX_LIMIT_CACHE["percent"] = remaining
+                return remaining
+    except Exception:
+        pass
+    return None
+
+
+def _get_openrouter_daily_spend() -> Optional[float]:
+    """Fetch usage_daily from OpenRouter auth/key endpoint with 30s cache."""
+    import json
+    import time
+    import urllib.request
+    from pathlib import Path
+
+    now = time.time()
+    if now - _OPENROUTER_USAGE_CACHE["ts"] < 30.0 and _OPENROUTER_USAGE_CACHE["daily_spend"] is not None:
+        return _OPENROUTER_USAGE_CACHE["daily_spend"]
+
+    api_key = os.environ.get("OPENROUTER_API_KEY")
+    if not api_key:
+        env_file = Path(os.path.expanduser("~/.hermes/.env"))
+        if env_file.exists():
+            try:
+                for line in env_file.read_text().splitlines():
+                    line = line.strip()
+                    if line.startswith("OPENROUTER_API_KEY="):
+                        api_key = line.split("=", 1)[1].strip().strip('"').strip("'")
+                        break
+            except Exception:
+                pass
+
+    if not api_key:
+        return None
+
+    try:
+        req = urllib.request.Request(
+            "https://openrouter.ai/api/v1/auth/key",
+            headers={"Authorization": f"Bearer {api_key}", "User-Agent": "hermes-agent"}
+        )
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            data = json.loads(resp.read().decode())
+            key_data = data.get("data", {})
+            daily = key_data.get("usage_daily")
+            if daily is not None:
+                val = float(daily)
+                _OPENROUTER_USAGE_CACHE["ts"] = now
+                _OPENROUTER_USAGE_CACHE["daily_spend"] = val
+                return val
+    except Exception:
+        pass
+    return None
+
 
